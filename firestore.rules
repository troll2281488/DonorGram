rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn() && (
        roomId == 'nova_lounge' ||
        (exists(/databases/$(database)/documents/rooms/$(roomId))
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members)
      );
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','email','createdAt','discoverable']);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','displayNameLower','createdAt']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 100
        && request.resource.data.keys().hasOnly(['name','type','members','createdBy','createdAt'])
        && request.resource.data.members.size() >= 1;
      allow read: if signedIn() &&
        (roomId == 'nova_lounge' || request.auth.uid in resource.data.members);
      // Membership management should be implemented server-side before enabling updates.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
              && request.resource.data.keys().hasOnly(['text','uid','displayName','createdAt','type']))
            ||
            (request.resource.data.type == 'media'
              && request.resource.data.text == ''
              && request.resource.data.media is map
              && request.resource.data.media.keys().hasOnly(['storagePath','mediaType','contentType','size','name'])
              && request.resource.data.media.storagePath is string
              && request.resource.data.media.storagePath.matches('rooms/' + roomId + '/' + request.auth.uid + '/.*')
              && request.resource.data.media.mediaType in ['image','video','file']
              && request.resource.data.media.contentType is string
              && request.resource.data.media.size is int
              && request.resource.data.media.size > 0
              && request.resource.data.media.size <= 83886080
              && request.resource.data.media.name is string
              && request.resource.data.media.name.size() <= 180
              && request.resource.data.keys().hasOnly(['text','uid','displayName','createdAt','type','media']))
          );
        allow update, delete: if false;
      }
    }
  }
}