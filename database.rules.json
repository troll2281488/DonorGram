{
  "rules": {
    "roomMembers": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.val() === true"
        }
      }
    },
    "rtdb-media": {
      "rooms": {
        "$roomId": {
          "$ownerUid": {
            "$fileId": {
              ".read": "auth != null && root.child('roomMembers').child($roomId).child(auth.uid).val() === true",
              ".write": "auth != null && auth.uid === $ownerUid && root.child('roomMembers').child($roomId).child(auth.uid).val() === true && newData.child('ownerUid').val() === auth.uid && newData.child('roomId').val() === $roomId",
              ".validate": "newData.hasChildren(['dataUrl','contentType','name','size','ownerUid','roomId','createdAt']) && newData.child('dataUrl').isString() && newData.child('dataUrl').val().length <= 7500000 && newData.child('size').isNumber() && newData.child('size').val() <= 4194304"
            }
          }
        }
      }
    }
  }
}