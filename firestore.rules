rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','email','createdAt','discoverable']);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {\n      allow read: if signedIn();\n      allow create, update: if signedIn() && request.auth.uid == userId\n        && request.resource.data.uid == userId\n        && request.resource.data.keys().hasOnly(['uid','displayName','displayNameLower','createdAt']);\n      allow delete: if signedIn() && request.auth.uid == userId;\n    }\n\n    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 100
        && request.resource.data.keys().hasOnly(['name','type','members','createdBy','createdAt'])\n        && request.resource.data.members.size() >= 1;
      allow read: if isMember(roomId);
      // Membership management should be implemented server-side before enabling updates.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly(['text','uid','displayName','createdAt','type']);
        allow update, delete: if false;
      }
    }
  }
}